.env
.env.*
*.env

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.claude/

cmds.txt

# ─────────────────────────────────────────────────────────────────────────────
# GitHub holds the app source + the dev/test tooling needed to build, check and
# test it. The exclusions below are for files that were dumped into the tree but
# are NOT app source — they stay on local disk only:
#   - docs & dev guides
#   - SQL / Supabase (migrations are produced here but applied as a separate
#     manual activity — the build process must never touch the database)
#   - CI / GitHub Actions automation
# (Tests, vitest.config and the type-check configs ARE source and are tracked.)
# ─────────────────────────────────────────────────────────────────────────────

# DB / Supabase — never on GitHub
/supabase/
/backups/

# Docs & dev guides
/docs/
CLAUDE.md
CLAUDE_general_dev_rules.md

# Dev tooling / scripts
/scripts/

# CI / automation
/.github/

# Env example / reference
.env.example
.env.example_with_debug

# Misc
.gitmodules

# Scratch — working files, test printouts, anything mid-task. NOTHING here is
# saved: it is a bin, not a folder. Emptying it must never lose work, and a
# stray `git add -A` must never sweep it into a commit (it has, twice).
/_scratch/

# Local history backup (contains pre-purge history — must never be committed)
/_history_backup/
