{
	"name": "lh-portal",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:devdb": "vite dev --port 5174 --mode devdb",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"start": "node start.js",
		"check": "cross-env NODE_OPTIONS=--max-old-space-size=4096 svelte-check --tsconfig ./tsconfig.check.json",
		"check:js": "cross-env NODE_OPTIONS=--max-old-space-size=4096 svelte-check --tsconfig ./jsconfig.json",
		"check:register": "node scripts/check-register-claims.mjs",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"db:push:dev": "node scripts/db-push.mjs dev",
		"db:push:test": "node scripts/db-push.mjs test",
		"db:push:prod": "node scripts/db-push.mjs prod",
		"db:rules": "node scripts/db-rules.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-netlify": "^7.0.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.19.1",
		"@vitest/coverage-v8": "^4.1.11",
		"autoprefixer": "^10.6.1",
		"cross-env": "^10.1.0",
		"jsdom": "^29.1.1",
		"postcss": "^8.5.6",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.131.0",
		"@sentry/sveltekit": "^10.76.0",
		"@supabase/supabase-js": "^2.117.2",
		"@tiptap/core": "3.31.3",
		"@tiptap/extension-table": "3.31.3",
		"@tiptap/starter-kit": "3.31.3",
		"browser-image-compression": "^2.0.2",
		"debug": "^4.4.3",
		"docx": "^9.8.1",
		"dompurify": "^3.4.5",
		"exceljs": "^4.4.0",
		"googleapis": "^183.0.0",
		"jszip": "^3.10.2"
	}
}
