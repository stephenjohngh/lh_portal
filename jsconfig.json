{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*.js", "*.ts"],
	"exclude": ["src/service-worker.js", "start.js"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		// noImplicitAny is off deliberately: with it on, checkJs produced ~3,100
		// pure-annotation errors (untyped params/vars) with near-zero bug-catching
		// value. Off, the strict null/property/assignability checks still run,
		// which is where real bugs surface. Editors read this file, so opened JS
		// is type-checked live. `npm run check:js` runs this config in CI-style.
		"noImplicitAny": false,
		"skipLibCheck": true,
		"moduleResolution": "bundler"
	}
	// #lib is a subpath import declared in package.json "imports".
}
